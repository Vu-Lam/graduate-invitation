# Copy file này thành .env (cùng thư mục với package.json)

# Chuỗi kết nối MongoDB (Atlas free: mongodb+srv://user:pass@cluster.mongodb.net/thiep-moi)
MONGODB_URI=mongodb://127.0.0.1:27017/thiep-moi

# Cổng chạy server API (và web khi đã build)
PORT=3001

# Địa chỉ public của web, dùng để in ra link thiệp khi chạy `npm run seed`
PUBLIC_URL=http://localhost:5173

# Bật sổ lưu bút (chỉ hiện những lời chúc bạn đã duyệt bằng `npm run wish`)
GUESTBOOK_ENABLED=false
